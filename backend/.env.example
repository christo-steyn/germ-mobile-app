PORT=3000
# Generate independently with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Never use the demo password or a shared/public example as the JWT secret.
JWT_SECRET=
NODE_ENV=development
ENABLE_TEST_ENDPOINTS=false
# Relative paths resolve against the backend directory, never the shell cwd.
DB_PATH=./data/germ.sqlite
# Comma-separated web origins; native mobile clients do not require a CORS origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional Expo enhanced push security credential:
EXPO_ACCESS_TOKEN=
