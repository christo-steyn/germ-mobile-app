PORT=3000
DATABASE_PATH=./data/germ.db
# Generate separate random values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional: enables the test alarm activation endpoint. Never put this in the mobile app.
ALARM_ADMIN_KEY=
# Optional: enable enhanced push security in your Expo project, then supply its access token.
EXPO_ACCESS_TOKEN=
# Native clients do not use CORS. Set an exact origin only if testing a browser client.
CORS_ORIGIN=
